[Unit]
Description=Hunter Threat Detonation Host Worker & API Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=hunter
Group=hunter
WorkingDirectory=/opt/hunter
EnvironmentFile=/opt/hunter/.env
ExecStart=/opt/hunter/.venv/bin/uvicorn src.api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
LimitNOFILE=65536

# Hardening
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
