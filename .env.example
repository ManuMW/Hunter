# Google AI Studio API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Gemini Model (e.g. gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Detonation Timeout in seconds
DETONATION_TIMEOUT=90

# Paths
QUARANTINE_DIR=quarantine
REPORTS_DIR=reports
ARTIFACTS_DIR=artifacts

# Docker Sandbox Image Tag
SANDBOX_IMAGE=threat-sandbox:latest
